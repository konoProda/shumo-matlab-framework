# latexmkrc —— 固定用 XeLaTeX 编译
#
# ctex 文档类需要 XeLaTeX（PDFLaTeX 会在中文字体处直接报错），
# 这里写死引擎，避免换机器后 latexmk 默认走 pdftex。
#
# 用法：latexmk -xelatex main.tex      （本文件已指定，直接 latexmk main.tex 亦可）
#       latexmk -C                     （清理中间文件）

$pdf_mode = 5;              # 5 = xelatex
$xelatex = 'xelatex -interaction=nonstopmode -halt-on-error -file-line-error %O %S';
$out_dir = '.';

# 参考文献与交叉引用需要多遍，latexmk 会自动判断；这里给足上限以防目录循环
$max_repeat = 5;

# 中间文件不删，便于出错时查看 .log
$clean_ext = 'aux log out toc fls fdb_latexmk synctex.gz';
